{
  // IMPORTANT: "name" must match your existing Worker name in the Cloudflare dashboard
  "name": "pvc-glossy",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "login-log", "database_id": "PASTE_YOUR_D1_DATABASE_ID" }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "PASTE_YOUR_CLIENT_ID.apps.googleusercontent.com",
    "OWNER_EMAIL": "your-email@gmail.com"
  }
}
